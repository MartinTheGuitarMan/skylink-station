# Copy to .env (make init does this with random secrets). .env is never committed.
INFLUX_ORG=skylink
INFLUX_USER=skylink
INFLUX_PASSWORD=change-me
INFLUX_TOKEN=change-me
GRAFANA_PASSWORD=change-me
# Interface the published ports bind to. 127.0.0.1 = this machine only; 0.0.0.0 = whole LAN.
BIND=127.0.0.1
# ssh name of the night host, used by scripts/night-sync.sh
NIGHT_HOST=
