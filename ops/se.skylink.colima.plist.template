<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>se.skylink.colima</string>
 <key>UserName</key><string>__USER__</string>
 <key>ProgramArguments</key><array>
  <string>/opt/homebrew/bin/colima</string><string>start</string>
  <string>--cpu</string><string>4</string><string>--memory</string><string>6</string>
  <string>--disk</string><string>40</string><string>--vm-type</string><string>vz</string><string>--foreground</string>
 </array>
 <key>RunAtLoad</key><true/>
 <key>KeepAlive</key><true/>
 <key>ThrottleInterval</key><integer>30</integer>
 <key>EnvironmentVariables</key><dict>
  <key>HOME</key><string>/Users/__USER__</string>
  <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
 </dict>
 <key>StandardOutPath</key><string>__REPO__/runs/colima.log</string>
 <key>StandardErrorPath</key><string>__REPO__/runs/colima.log</string>
</dict></plist>
